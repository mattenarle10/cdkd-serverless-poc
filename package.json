{
  "name": "cdkd-serverless-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "synth": "cdk synth --quiet",
    "synth:cdk": "cdk synth --quiet --output cdk.out.cfn",
    "synth:cdkd": "cdkd synth --output cdk.out.cdkd",
    "compare:templates": "node scripts/compare-templates.mjs",
    "verify": "npm run check && npm test && npm run synth:cdk && npm run synth:cdkd && npm run compare:templates"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1107.0",
    "@aws-sdk/client-sqs": "3.1107.0",
    "@aws-sdk/lib-dynamodb": "3.1107.0",
    "aws-cdk-lib": "2.264.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@go-to-k/cdkd": "0.280.17",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "24.13.3",
    "aws-cdk": "2.1136.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
